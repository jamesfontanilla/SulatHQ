{
  "name": "email-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:security": "node --experimental-strip-types --test tests/account-security.test.ts",
    "test:phase1": "node --experimental-strip-types --test tests/phase1-search.test.ts",
    "test:phase2": "node --experimental-strip-types --test tests/phase2-rules-work.test.ts",
    "test:phase3": "node --experimental-strip-types --test tests/phase3-send-attachments.test.ts",
    "test:phase4": "node --experimental-strip-types --test tests/phase4-trust-screening.test.ts",
    "test:ux": "node --experimental-strip-types --test tests/frontend-ux.test.ts",
    "test:platform": "node --experimental-strip-types --test tests/platform-contracts.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "@supabase/supabase-js": "^2.57.0",
    "dompurify": "^3.4.14",
    "lucide-react": "^0.468.0",
    "postal-mime": "^2.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.32.0"
  }
}
